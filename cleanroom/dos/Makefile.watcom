# cleanroom/dos/Makefile.watcom
# Cross-compile libopenlnk 16-bit Real-Mode MS-DOS targets (8.3 compliant)
# using Open Watcom v2:
#   - OPENSVR.EXE          (16-bit DOS server with 8250/16550A + INT 25h/26h HAL)
#   - OPENLNK.EXE          (16-bit DOS client CLI with 8250/16550A HAL)
#   - openlnk_sys_stub.obj (OPENLNK.SYS DOS block device driver core object)
#
# Expected environment:
#   WATCOM=/opt/watcom
#   PATH=$WATCOM/binl64:$PATH
#   INCLUDE=$WATCOM/h

CC      = wcc
WLINK   = wlink
WLIB    = wlib

# -ms   : Small memory model (16-bit near code & near data, 8086/8088 compatible)
# -0    : 8086/8088 instruction set (also runs on NEC V30)
# -za99 : Strict ISO C99 mode
# -wx   : Maximum warning level
# -we   : Treat warnings as errors
# -os   : Optimize for size
CFLAGS  = -ms -0 -za99 -wx -we -os -bt=dos -i=../include

BUILD_DIR = build

CORE_OBJS = \
	$(BUILD_DIR)/openlnk.obj \
	$(BUILD_DIR)/crc16.obj \
	$(BUILD_DIR)/protocol.obj \
	$(BUILD_DIR)/storage_mem.obj \
	$(BUILD_DIR)/server.obj \
	$(BUILD_DIR)/client.obj

DOS_HAL_OBJS = \
	$(BUILD_DIR)/dos_hal_uart.obj \
	$(BUILD_DIR)/dos_hal_disk.obj

all: $(BUILD_DIR) $(BUILD_DIR)/OPENSVR.EXE $(BUILD_DIR)/OPENLNK.EXE $(BUILD_DIR)/openlnk_sys_stub.obj

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

$(BUILD_DIR)/openlnk.obj: ../src/openlnk.c
	$(CC) $(CFLAGS) -fo=$@ ../src/openlnk.c

$(BUILD_DIR)/crc16.obj: ../src/crc16.c
	$(CC) $(CFLAGS) -fo=$@ ../src/crc16.c

$(BUILD_DIR)/protocol.obj: ../src/protocol.c
	$(CC) $(CFLAGS) -fo=$@ ../src/protocol.c

$(BUILD_DIR)/storage_mem.obj: ../src/storage_mem.c
	$(CC) $(CFLAGS) -fo=$@ ../src/storage_mem.c

$(BUILD_DIR)/server.obj: ../src/server.c
	$(CC) $(CFLAGS) -fo=$@ ../src/server.c

$(BUILD_DIR)/client.obj: ../src/client.c
	$(CC) $(CFLAGS) -fo=$@ ../src/client.c

$(BUILD_DIR)/dos_hal_uart.obj: dos_hal_uart.c dos_hal_uart.h
	$(CC) $(CFLAGS) -fo=$@ dos_hal_uart.c

$(BUILD_DIR)/dos_hal_disk.obj: dos_hal_disk.c dos_hal_disk.h
	$(CC) $(CFLAGS) -fo=$@ dos_hal_disk.c

$(BUILD_DIR)/libolnk.lib: $(CORE_OBJS)
	$(WLIB) -q -n -b $@ +$(BUILD_DIR)/openlnk.obj +$(BUILD_DIR)/crc16.obj +$(BUILD_DIR)/protocol.obj +$(BUILD_DIR)/storage_mem.obj +$(BUILD_DIR)/server.obj +$(BUILD_DIR)/client.obj

$(BUILD_DIR)/opensvr_main.obj: opensvr_main.c dos_hal_uart.h dos_hal_disk.h
	$(CC) $(CFLAGS) -fo=$@ opensvr_main.c

$(BUILD_DIR)/openlnk_main.obj: openlnk_main.c dos_hal_uart.h
	$(CC) $(CFLAGS) -fo=$@ openlnk_main.c

$(BUILD_DIR)/openlnk_sys_stub.obj: openlnk_sys_stub.c openlnk_sys.h dos_hal_uart.h
	$(CC) $(CFLAGS) -zl -s -fo=$@ openlnk_sys_stub.c

$(BUILD_DIR)/OPENSVR.EXE: $(BUILD_DIR)/opensvr_main.obj $(DOS_HAL_OBJS) $(BUILD_DIR)/libolnk.lib
	$(WLINK) system dos option quiet option stack=4096 name $@ file $(BUILD_DIR)/opensvr_main.obj file $(BUILD_DIR)/dos_hal_uart.obj file $(BUILD_DIR)/dos_hal_disk.obj library $(BUILD_DIR)/libolnk.lib

$(BUILD_DIR)/OPENLNK.EXE: $(BUILD_DIR)/openlnk_main.obj $(BUILD_DIR)/dos_hal_uart.obj $(BUILD_DIR)/libolnk.lib
	$(WLINK) system dos option quiet option stack=4096 name $@ file $(BUILD_DIR)/openlnk_main.obj file $(BUILD_DIR)/dos_hal_uart.obj library $(BUILD_DIR)/libolnk.lib

clean:
	rm -rf $(BUILD_DIR)
