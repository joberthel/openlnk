{
  "name": "openlnk",
  "version": "0.3.2",
  "description": "OpenLNK (libopenlnk): clean-room allocation-free C99 MS-DOS INTERLNK/INTERSVR serial/SD block server library",
  "keywords": [
    "openlnk",
    "msdos",
    "interlnk",
    "intersvr",
    "serial",
    "rs232",
    "max3232",
    "sdmmc",
    "sdspi",
    "retrocomputing",
    "fat16"
  ],
  "homepage": "https://github.com/joberthel/openlnk",
  "repository": {
    "type": "git",
    "url": "https://github.com/joberthel/openlnk.git"
  },
  "license": "MIT",
  "frameworks": [
    "espidf",
    "arduino"
  ],
  "platforms": [
    "espressif32"
  ],
  "headers": [
    "openlnk_esp32.h"
  ],
  "build": {
    "srcDir": "src",
    "includeDir": "include",
    "extraScript": "pio_build.py"
  }
}
