# tools/bench/dos_profiler/Makefile.watcom
# Build 16-bit MS-DOS RAM benchmark helpers (MEMBENCH.EXE, COM2LOG.EXE)
# using Open Watcom v2 (local $WATCOM or openlnk-watcom Docker image).

CC      = wcc
AS      = wasm
WLINK   = wlink

OUT_DIR ?= build
CFLAGS  = -ms -0 -os -wx -bt=dos
ASFLAGS = -0 -ms -wx -we -q

all: $(OUT_DIR) $(OUT_DIR)/MEMBENCH.EXE $(OUT_DIR)/COM2LOG.EXE

$(OUT_DIR):
	mkdir -p $(OUT_DIR)

$(OUT_DIR)/com2log.obj: com2log.c
	$(CC) $(CFLAGS) -fo=$@ com2log.c

$(OUT_DIR)/COM2LOG.EXE: $(OUT_DIR)/com2log.obj
	$(WLINK) system dos option quiet name $@ file $<

$(OUT_DIR)/bench_asm.obj: bench_asm.asm
	$(AS) $(ASFLAGS) -fo=$@ bench_asm.asm

$(OUT_DIR)/membench.obj: membench.c
	$(CC) $(CFLAGS) -fo=$@ membench.c

$(OUT_DIR)/MEMBENCH.EXE: $(OUT_DIR)/membench.obj $(OUT_DIR)/bench_asm.obj
	$(WLINK) system dos option quiet option stack=4096 name $@ file $(OUT_DIR)/membench.obj file $(OUT_DIR)/bench_asm.obj

clean:
	rm -rf $(OUT_DIR)
